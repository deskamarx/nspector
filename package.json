{
  "name": "nspector",
  "version": "1.0.0",
  "description": "Device inventory inspector — duplicate IMEI, return and ownership tracking",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "dev": "npm run rebuild:electron && electron .",
    "dist": "npm run rebuild:electron && electron-builder --win --x64",
    "dist:all": "npm run rebuild:electron && electron-builder --win --x64 --linux --mac",
    "apk": "android\\build-apk.bat",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "author": "NSpector",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nspector.app",
    "productName": "NSpector",
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*.csv",
          "**/*.json",
          "**/*.txt"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NSpector"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@33.4.11": true
  }
}
